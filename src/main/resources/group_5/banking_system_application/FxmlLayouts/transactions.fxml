<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="group_5.banking_system_application.Ui.TransactionsController"
            fitToWidth="true"
            styleClass="content-scroll"
            fx:id="root">
    <content>
        <VBox spacing="20" styleClass="page-root">
            <VBox spacing="16" styleClass="page-header">
                <VBox spacing="6">
                    <Label text="Transactions" styleClass="screen-title"/>
                    <Label text="Review and filter your recent activity." styleClass="page-subtitle" wrapText="true"/>
                </VBox>

                <HBox spacing="18" alignment="CENTER_LEFT">
                    <VBox spacing="4" alignment="CENTER_LEFT">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                                <image>
                                    <Image url="@../images/filter-icon.png"/>
                                </image>
                            </ImageView>
                            <Label text="Filter" styleClass="control-label"/>
                        </HBox>
                        <ComboBox fx:id="comboBox" promptText="All activity" prefWidth="200" styleClass="top-combo"/>
                    </VBox>

                    <VBox spacing="4" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                                <image>
                                    <Image url="@../images/search-icon.png"/>
                                </image>
                            </ImageView>
                            <Label text="Search" styleClass="control-label"/>
                        </HBox>
                        <TextField fx:id="searchField" promptText="Search by description or email"
                                   maxWidth="Infinity" styleClass="search-field"/>
                    </VBox>
                </HBox>
            </VBox>

            <HBox spacing="18" styleClass="stat-row">
                <VBox styleClass="card stat-card" spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Spent this month" styleClass="stat-card-title"/>
                    <Label fx:id="monthSpentLabel" text="\$0.00" styleClass="card-value"/>
                    <Label fx:id="monthSpentTrendLabel" text="Loading trend" styleClass="stat-trend trend-neutral" wrapText="true"/>
                </VBox>
                <VBox styleClass="card stat-card" spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Received this month" styleClass="stat-card-title"/>
                    <Label fx:id="monthReceivedLabel" text="\$0.00" styleClass="card-value"/>
                    <Label text="Incoming transfers and bonuses" styleClass="stat-trend trend-neutral" wrapText="true"/>
                </VBox>
            </HBox>

            <TableView fx:id="transactionsTable" VBox.vgrow="ALWAYS" fixedCellSize="40" styleClass="table-card" minHeight="320">
                <columns>
                    <TableColumn fx:id="dateColumn" text="Date" prefWidth="140"/>
                    <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="260"/>
                    <TableColumn fx:id="amountColumn" text="Amount" prefWidth="110"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="110"/>
                    <TableColumn fx:id="balanceColumn" text="Balance" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>
    </content>
</ScrollPane>
