<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="group_5.banking_system_application.Ui.AccountController"
            fitToWidth="true"
            styleClass="content-scroll"
            fx:id="root">
    <content>
        <VBox spacing="20" styleClass="page-root" maxWidth="640">
            <VBox spacing="6">
                <Label text="Account" styleClass="screen-title"/>
                <Label text="View and update your Vaultiq profile. Balance updates after transfers."
                       styleClass="page-subtitle" wrapText="true"/>
            </VBox>

            <VBox styleClass="card" spacing="14">
                <Label text="Profile" styleClass="section-heading"/>
                <GridPane hgap="12" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120" prefWidth="140"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="First name" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="field-label"/>
                    <TextField fx:id="firstNameField" promptText="First name" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Last name" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="field-label"/>
                    <TextField fx:id="lastNameField" promptText="Last name" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Email" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="field-label"/>
                    <Label fx:id="emailLabel" text="—" wrapText="true" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="account-readonly"/>
                    <Label text="Balance" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="field-label"/>
                    <Label fx:id="balanceLabel" text="\$0.00" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="card-value"/>
                    <Label text="User ID" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="field-label"/>
                    <Label fx:id="userIdLabel" text="—" wrapText="true" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="account-readonly"/>
                </GridPane>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Button text="Save changes" styleClass="primary-btn" onAction="#onSave"/>
                    <Button text="Refresh" styleClass="secondary-btn" onAction="#onRefresh"/>
                </HBox>
                <Label fx:id="statusLabel" text="Loading account…" styleClass="page-subtitle" wrapText="true"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
