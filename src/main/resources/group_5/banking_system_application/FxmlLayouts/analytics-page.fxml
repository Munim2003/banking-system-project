<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="group_5.banking_system_application.Ui.AnalyticsController"
            fitToWidth="true"
            styleClass="content-scroll"
            fx:id="root">
    <content>
        <VBox spacing="20" styleClass="page-root">
            <VBox spacing="6">
                <Label text="Analytics" styleClass="screen-title"/>
                <Label text="Balance history and monthly cash flow from your Vaultiq activity."
                       styleClass="page-subtitle" wrapText="true"/>
            </VBox>

            <HBox spacing="18" styleClass="stat-row">
                <VBox styleClass="card stat-card" spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Received this month" styleClass="stat-card-title"/>
                    <Label fx:id="receivedMonthLabel" text="\$0.00" styleClass="card-value"/>
                </VBox>
                <VBox styleClass="card stat-card" spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Sent this month" styleClass="stat-card-title"/>
                    <Label fx:id="sentMonthLabel" text="\$0.00" styleClass="card-value"/>
                </VBox>
                <VBox styleClass="card stat-card" spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Net this month" styleClass="stat-card-title"/>
                    <Label fx:id="netMonthLabel" text="\$0.00" styleClass="card-value"/>
                </VBox>
            </HBox>

            <HBox spacing="18" styleClass="stat-row">
                <VBox styleClass="card stat-card" spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Balance trend" styleClass="stat-card-title"/>
                    <Label fx:id="balanceTrendLabel" text="Loading trend" styleClass="stat-trend trend-neutral" wrapText="true"/>
                </VBox>
                <VBox styleClass="card stat-card" spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Spending trend" styleClass="stat-card-title"/>
                    <Label fx:id="spendTrendLabel" text="Loading trend" styleClass="stat-trend trend-neutral" wrapText="true"/>
                </VBox>
            </HBox>

            <VBox styleClass="card insight-card" spacing="8">
                <Label text="Insight" styleClass="section-heading"/>
                <Label fx:id="insightLabel" text="Loading insights..." styleClass="page-subtitle" wrapText="true"/>
            </VBox>

            <VBox styleClass="card" spacing="10" minHeight="360">
                <Label text="Balance after each transaction" styleClass="section-heading"/>
                <StackPane fx:id="growthChart" VBox.vgrow="ALWAYS" minHeight="280"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
