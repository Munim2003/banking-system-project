<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="group_5.banking_system_application.Ui.DashboardController"
            fitToWidth="true"
            styleClass="content-scroll"
            fx:id="root">
    <content>
        <VBox spacing="20" styleClass="page-root">
            <VBox spacing="4">
                <Label fx:id="welcomeLabel" styleClass="screen-title dashboard-welcome" text="Welcome back"/>
                <Label text="Here is a snapshot of your Vaultiq accounts." styleClass="page-subtitle" wrapText="true"/>
            </VBox>

            <HBox spacing="18">
                <VBox styleClass="card dashboard-panel" spacing="10" HBox.hgrow="ALWAYS" minHeight="150">
                    <Label text="Total balance" styleClass="section-heading"/>
                    <Label fx:id="totalBalanceLabel" text="\$0.00" styleClass="card-value"/>
                    <Label fx:id="balanceTrendLabel" text="Loading trend" styleClass="stat-trend trend-neutral" wrapText="true"/>
                </VBox>
                <VBox styleClass="card dashboard-panel" spacing="10" HBox.hgrow="ALWAYS" minHeight="150">
                    <Label text="Monthly spending" styleClass="section-heading"/>
                    <Label fx:id="monthlySpendLabel" text="\$0.00" styleClass="card-value"/>
                    <Label fx:id="spendTrendLabel" text="Loading trend" styleClass="stat-trend trend-neutral" wrapText="true"/>
                </VBox>
                <VBox styleClass="card dashboard-panel" spacing="10" HBox.hgrow="ALWAYS" minHeight="150">
                    <Label text="Accounts" styleClass="section-heading"/>
                    <Label fx:id="activeAccountsLabel" text="1" styleClass="card-value"/>
                    <Label text="1 checking, 0 savings" styleClass="stat-trend trend-neutral" wrapText="true"/>
                </VBox>
            </HBox>

            <HBox spacing="18">
                <VBox styleClass="card dashboard-panel" spacing="10" HBox.hgrow="ALWAYS" minHeight="220">
                    <Label text="Account growth" styleClass="section-heading"/>
                    <StackPane fx:id="growthChart" VBox.vgrow="ALWAYS" minHeight="160"/>
                </VBox>

                <VBox styleClass="card dashboard-panel" spacing="12" prefWidth="260" minWidth="240"
                      alignment="TOP_CENTER" minHeight="220">
                    <Label text="Quick actions" styleClass="section-heading"/>
                    <Button text="Transfer funds" styleClass="primary-btn" onAction="#onTransferClicked"/>
                    <Button text="View statements" styleClass="secondary-btn"/>
                    <Button text="Add beneficiary" styleClass="secondary-btn" onAction="#onAddBeneficiaryClicked"/>
                </VBox>
            </HBox>

            <VBox styleClass="card dashboard-panel" spacing="10" maxWidth="Infinity">
                <Label text="Recent activity" styleClass="section-heading"/>
                <VBox fx:id="recentActivityContainer" spacing="6"/>
            </VBox>

            <HBox fx:id="tickerContainer" alignment="CENTER_LEFT" styleClass="ticker-container"
                  prefHeight="40" maxHeight="40" minHeight="40">
                <Label fx:id="tickerLabel" styleClass="ticker-text" text="Loading suggestions..."/>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
